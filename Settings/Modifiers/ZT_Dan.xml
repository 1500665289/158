				<li Name="ExperiencePrestigeAddP" AddP="0.5"/><!--历练型声望放大系数-->
				<li Name="EsotericaNum" AddV="99"/><!--秘籍数量限制-->
				<li Name="AbilityLvAddV" AddV="90"/><!--道行加值-->
		</Properties>
