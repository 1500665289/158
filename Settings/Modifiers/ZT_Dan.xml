				<li Name="NpcFight_FabaoTurnSpeedAddP" AddP="0.25"/><!--法宝转向速度加成-->
				<li Name="NpcFight_FabaoRepelResistanceAddV" AddP="0.25"/><!--法宝击退距离抗性-->
				<li Name="NpcFight_FabaoTrailingLengthAddP" AddP="0.5"/><!--法宝拖尾长度加成-->
				<li Name="NpcFight_SpellLingCostAddP" AddP="-0.1"/><!--术法灵气消耗加成-->
				<li Name="NpcFight_SpellCastTimeAddP" AddP="-0.1"/><!--术法吟唱时间加成-->
				<li Name="NpcFight_SpellPowerAddP" AddP="0.5"/><!--术法伤害加成-->
				<li Name="NpcFight_SpellCoolDownAddP" AddP="-0.1"/><!--术法冷却时间加成-->
				<li Name="NpcFight_ShieldConversionRate" AddP="0.5"/><!--护盾强度加值-->
				<li Name="NpcFight_ShieldConversionRateAddP" AddV="1"/><!--护盾强度加成-->
				<li Name="NpcFight_ZhenKeyPointNum" AddV="1"/><!--阵法规模-->
				<li Name="NpcFight_ZhenEnginePower" AddV="1"/><!--阵法负荷能力-->
				<li Name="NpcFight_FabaoNum" AddV="1"/><!--法宝数量-->
				
				
				修行
				<li Name="PracticeRateAddPFromDan" AddP="0.2"/><!--瓶颈突破概率加成系数-->
				<li Name="ExperienceNeckTimeCostCoefficient" AddP="-0.5"/><!--历练型瓶颈时间放大系数-->
				<li Name="PotentialOfBasepracticeAddValue" AddV="0.5"/><!--潜力值-->
				<li Name="GodPenaltyAddV" AddV="20"/><!--天谴，正的加天谴的。-->
