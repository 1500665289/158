				<li Name="PainTolerance" AddV="2"/><!--疼痛忍受极限-->
				<li Name="IntelligenceSkillEXPConstant" AddP="0.1"/><!--学习速度加成-->
				<li Name="PracticeFoodConsumeConstant" AddP="0.5"/><!--精元消耗速度-->
				<li Name="FatigueConsumeConstant" AddP="-0.25"/><!--精力消耗速度-->
				
				战斗
				<li Name="NpcFight_BaseHitChance" AddV="0.5"/><!--战斗命中-->
				<li Name="NpcFight_BaseDodgeChance" AddV="0.5"/><!--战斗闪避-->
				<li Name="NpcFight_FabaoPowerAddP" AddP="0.25"/><!--法宝威力加成-->
				<li Name="NpcFight_FabaoLingRecoverAddP" AddP="0.25"/><!--法宝灵气恢复速度加成-->
