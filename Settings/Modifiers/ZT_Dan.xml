				<li Name="DeepPracticeSpeedSpecialCoefficient" AddP="0.5"/><!--瓶颈突破概率加成系数-->
				<li Name="InspirationCoefficient" AddP="0.5"/><!--领悟悟性-->
				<li Name="LingAbsorbSpeed" AddP="1"/><!--灵气吸收速度-->
				<li Name="NpcLingMaxValue" AddV="10000"/><!--基础灵气最大值-->
				<li Name="WorldMapFlySpeed" AddP="0.5"/><!--历练飞行速度-->
